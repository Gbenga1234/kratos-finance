# Local development only. Replace every value before deployment.
APP_ENV=development
API_PORT=8000
POSTGRES_DB=finance
POSTGRES_USER=finance
POSTGRES_PASSWORD=local-development-only-change-me
DATABASE_URL=postgresql+psycopg://finance:local-development-only-change-me@db:5432/finance
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
TRUSTED_HOSTS=["localhost","127.0.0.1"]
MAX_TRANSFER_AMOUNT=10000000
SUPPORTED_CURRENCIES=["USD","EUR","GBP"]
LOG_LEVEL=INFO
